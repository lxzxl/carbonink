---
const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';

const tx = isZh
  ? {
      title: '专为顾问与一线团队设计的细节',
      items: [
        {
          tag: 'LOCAL SQLITE',
          title: '轻量原生 · 数据完全离线',
          body: '轻量原生 macOS 与 Windows 应用，内置自动更新。所有台账、排放因子与草稿只保存在本地 SQLite，无云端同步、无需账号，彻底消除数据外泄顾虑。',
        },
        {
          tag: 'BYOK AI · MCP',
          title: 'AI 数据工程与 MCP 协议直连',
          body: '单据批量解析、整表导入按组确认因子，自带 OpenAI / Anthropic / Google Gemini / DeepSeek / Moonshot 接口密钥。内置 stdio MCP 服务与 Agent Skill，供 Claude / Cursor 直连本地清单。',
        },
        {
          tag: 'OUTBOUND + SCOPE 3',
          title: '盘查与上下游双向披露打通',
          body: '自动回填客户披露问卷并留存 AI 工具调用链；同时支持 Scope 3 Cat 1/4/5/6 与自定义模板向供应商收数（Tier 1–3），对方用 Excel 填写发回即可入库，零平台账户。',
        },
        {
          tag: 'LINEAGE · WORKSPACES',
          title: '全链路溯源与顾问多客户账套',
          body: '每条排放均可一键定位原始凭证与已冻结排放因子；附带发布前就绪体检、自定义报告封面 Logo、SHA-256 核查交付包，以及一客户一独立数据库文件与每日自动备份。',
        },
      ],
    }
  : {
      title: 'Engineered for verification, not marketing dashboards',
      items: [
        {
          tag: 'LOCAL SQLITE',
          title: 'Lightweight native desktop · Fully offline',
          body: 'Fast native macOS & Windows app with built-in automatic updates. Everything lives in local SQLite on your machine — no cloud sync, no accounts, and zero telemetry on inventory data.',
        },
        {
          tag: 'BYOK AI · MCP',
          title: 'AI data engineering + bundled MCP server',
          body: 'Batch-extract scanned PDFs and xlsx/csv ledgers with your own key (OpenAI, Anthropic, Google Gemini, DeepSeek, Moonshot). Bundled stdio MCP & Agent Skill connect Claude Desktop and Cursor to your workspace.',
        },
        {
          tag: 'OUTBOUND + SCOPE 3',
          title: 'Bidirectional customer & supplier disclosures',
          body: 'Auto-fill outbound ESG questionnaires with inspectable Answer Agent traces, and collect supplier Scope 3 data (Cat 1/4/5/6 or custom templates, Tier 1–3) via zero-account xlsx round-trips.',
        },
        {
          tag: 'LINEAGE · WORKSPACES',
          title: 'End-to-end lineage & multi-client isolation',
          body: 'Trace any figure back to source bills and pinned factor snapshots. Ships with deterministic readiness checks, custom report logo support, SHA-256 deliverable ZIPs, and isolated per-client SQLite workspaces.',
        },
      ],
    };
---
<section class="py-16 sm:py-20 px-5 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-8">
      {tx.title}
    </h2>
    <div class="grid md:grid-cols-2 border border-border bg-card">
      {tx.items.map((item, idx) => (
        <div
          class:list={[
            'p-6 sm:p-7 border-border flex flex-col justify-between',
            idx < 2 ? 'border-b' : 'border-b md:border-b-0',
            idx === 3 ? 'border-b-0' : '',
            idx % 2 === 0 ? 'md:border-r' : '',
          ]}
        >
          <div>
            <h3 class="font-display font-bold text-base tracking-tight text-foreground mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{item.body}</p>
          </div>
          <div class="mt-5 pt-3 border-t border-border">
            <span class="font-mono-num text-[11px] font-semibold text-primary">
              {item.tag}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
