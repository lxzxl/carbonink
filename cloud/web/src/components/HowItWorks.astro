---
const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';

const tx = isZh
  ? {
      title: '三步完成可核查盘查',
      steps: [
        {
          num: '01',
          title: '投递单据或整表导入台账',
          body: '拖入电费单、燃料发票、货运差旅凭证（PDF / 图片），或整表导入 Excel / CSV 活动台账。',
          io: '输入：PDF · 图片 · XLSX · CSV',
        },
        {
          num: '02',
          title: 'AI 提取并冻结排放因子',
          body: 'AI 抽取字段并匹配内置 IPCC / DEFRA / EPA / 生态环境部或自有因子库；经人工确认后写入不可变计算快照。',
          io: '锁定：人工确认 + EF 快照 + 证据链',
        },
        {
          num: '03',
          title: '导出报告与 SHA-256 交付包',
          body: '运行发布前就绪体检后，一键生成 ISO 14064-1 盘查报告与 TCFD 四支柱披露，打包为带哈希清单的离线交付物。',
          io: '产出：PDF + Excel + SHA-256 ZIP',
        },
      ],
    }
  : {
      title: 'Three steps to an audit-ready inventory',
      steps: [
        {
          num: '01',
          title: 'Drop bills or import whole ledgers',
          body: 'Import utility bills, fuel receipts, and freight docs (PDF / images), or bulk-load existing Excel / CSV activity ledgers.',
          io: 'Input: PDF · Images · XLSX · CSV',
        },
        {
          num: '02',
          title: 'AI extracts, human locks EFs',
          body: 'AI parses records and ranks factors from IPCC, DEFRA, EPA eGRID, China MEE, or your custom library; confirmation freezes the snapshot.',
          io: 'Lock: Pinned EF + Row lineage',
        },
        {
          num: '03',
          title: 'Export reports & SHA-256 bundle',
          body: 'Run deterministic readiness checks and export editable ISO 14064-1 & TCFD reports (PDF + Excel) in a SHA-256 verified ZIP.',
          io: 'Output: PDF + XLSX + SHA-256 ZIP',
        },
      ],
    };
---
<section class="py-16 sm:py-20 px-5 sm:px-6 bg-card border-y border-border">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-10">
      {tx.title}
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      {tx.steps.map((step) => (
        <div class="border border-border border-t-2 border-t-border-strong bg-surface p-6 flex flex-col justify-between gap-6">
          <div>
            <div class="flex items-baseline gap-2.5 mb-2.5">
              <span class="font-mono-num text-base font-semibold text-primary shrink-0">{step.num}</span>
              <h3 class="font-display font-bold text-base tracking-tight text-foreground">{step.title}</h3>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">{step.body}</p>
          </div>
          <div class="font-mono-num text-xs text-foreground bg-card border border-border px-3 py-2">
            {step.io}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
