---
const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';
const prefix = isZh ? '/zh' : '';

const tx = isZh
  ? {
      quote: '碳墨没有账号、没有许可证、不向任何地方上报。你算了什么、填了什么、问 AI 什么——没有任何服务器能接触到它们。',
      policyLink: '查看完整隐私政策 →',
      rows: [
        { k: '本地数据', v: 'SQLite · 仅驻留本机目录' },
        { k: '网络出口', v: '仅在主动调用自备 Key AI 或检查更新时发起请求' },
        { k: '桌面端遥测', v: '无（0 telemetry bytes）' },
      ],
    }
  : {
      quote: "CarbonInk has no account, no license server, and nothing that phones home. What you calculated, filed, or asked your AI never touches an external backend.",
      policyLink: 'Read full privacy architecture →',
      rows: [
        { k: 'Data on disk', v: 'SQLite · stays inside your local user folder' },
        { k: 'Network egress', v: 'Direct BYOK model API calls or optional release check only' },
        { k: 'App telemetry', v: 'None (0 analytics bytes sent)' },
      ],
    };
---
<section class="chamber-surface py-16 sm:py-20 px-5 sm:px-6 bg-chamber text-chamber-foreground border-b-2 border-border-strong">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    <div class="min-w-0 lg:col-span-7">
      <blockquote class="font-display text-xl sm:text-2xl font-bold tracking-tight leading-snug text-white">
        “{tx.quote}”
      </blockquote>
      <p class="mt-4">
        <a
          href={`${prefix}/privacy/`}
          class="text-sm font-semibold text-emerald-bright hover:text-white underline transition-colors"
        >
          {tx.policyLink}
        </a>
      </p>
    </div>

    <div class="min-w-0 lg:col-span-5 border-t-2 border-white/35 border-b border-chamber-border bg-black/20">
      {tx.rows.map((r) => (
        <div class="grid grid-cols-[118px_minmax(0,1fr)] gap-3 px-4 py-3 border-b border-chamber-border last:border-b-0 items-baseline">
          <span class="font-mono-num text-[11px] font-medium text-emerald-bright">{r.k}</span>
          <span class="text-[13px] text-chamber-foreground font-medium">{r.v}</span>
        </div>
      ))}
    </div>
  </div>
</section>
