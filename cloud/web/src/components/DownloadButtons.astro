---
const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';

const tx = isZh
  ? {
      mac: '下载 macOS 版 (.dmg)',
      macNote: 'Apple Silicon · macOS 13+',
      macSize: '15.5 MB',
      macIntel: '使用 Intel 芯片的 Mac？下载 Intel 版 (.dmg · 17.7 MB)',
      win: '下载 Windows 版 (.exe)',
      winNote: 'Windows 10 / 11 (64-bit)',
      winSize: '17.1 MB',
      signingTitle: '未签名开源构建 · 首次打开提示',
      signing:
        '应用未购买商业代码签名（免费开源，源码公开）。首次运行：macOS 请右键点按应用图标 →「打开」；Windows 如遇 SmartScreen 提示，选「更多信息 → 仍要运行」。',
    }
  : {
      mac: 'Download for macOS (.dmg)',
      macNote: 'Apple Silicon · macOS 13+',
      macSize: '15.5 MB',
      macIntel: 'On an Intel Mac? Download Intel build (.dmg · 17.7 MB)',
      win: 'Download for Windows (.exe)',
      winNote: 'Windows 10 / 11 (64-bit)',
      winSize: '17.1 MB',
      signingTitle: 'Unsigned open-source builds · First launch',
      signing:
        'Builds are unsigned (free & open-source). On macOS first launch, right-click the app → Open; on Windows SmartScreen, choose "More info → Run anyway".',
    };

const macHref = '/download/mac';
const winHref = '/download/win';
const macIntelHref = '/download/mac?arch=x64';
---
<div class="p-6 sm:p-8 flex flex-col gap-3">
  <a
    href={macHref}
    class="flex items-center gap-3.5 border border-border-strong bg-chamber text-chamber-foreground rounded-[2px] px-4 sm:px-5 py-4 hover:bg-moss-900 transition-colors text-left group"
  >
    <div class="w-9 h-9 rounded-[2px] bg-white/10 border border-chamber-border flex items-center justify-center shrink-0">
      <svg viewBox="0 0 24 24" class="w-5 h-5 text-white" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display font-bold text-sm text-white">{tx.mac}</p>
      <p class="font-mono-num text-xs text-chamber-muted mt-0.5">{tx.macNote}</p>
    </div>
    <span class="font-mono-num text-xs font-semibold text-emerald-bright border border-emerald-bright/35 px-2 py-1 rounded-[2px] shrink-0">
      {tx.macSize}
    </span>
  </a>

  <a
    href={macIntelHref}
    class="font-mono-num text-xs text-primary hover:text-chamber underline self-start transition-colors"
  >
    {tx.macIntel}
  </a>

  <a
    href={winHref}
    class="flex items-center gap-3.5 border border-border-strong bg-surface text-foreground rounded-[2px] px-4 sm:px-5 py-4 hover:bg-muted transition-colors text-left group mt-1"
  >
    <div class="w-9 h-9 rounded-[2px] bg-card border border-border flex items-center justify-center shrink-0">
      <svg viewBox="0 0 24 24" class="w-5 h-5 text-foreground" fill="currentColor" aria-hidden="true">
        <path d="M3 5.557L10.267 4.6l.004 7.343-7.26.043L3 5.557zm7.265 7.158l.006 7.347L3.002 19.1l-.001-6.428 7.264.043zm.898-8.222L21 3v8.895l-9.837.077V4.493zm9.839 8.386l-.002 8.893L11.163 20.6l-.012-7.706 9.851.001z" />
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display font-bold text-sm text-foreground">{tx.win}</p>
      <p class="font-mono-num text-xs text-muted-foreground mt-0.5">{tx.winNote}</p>
    </div>
    <span class="font-mono-num text-xs font-semibold text-foreground bg-card border border-border px-2 py-1 rounded-[2px] shrink-0">
      {tx.winSize}
    </span>
  </a>
</div>

<div class="px-6 sm:px-8 py-4 sm:py-5 bg-surface text-left">
  <p class="font-mono-num text-[11px] font-semibold text-ochre mb-1">{tx.signingTitle}</p>
  <p class="text-xs text-muted-foreground leading-relaxed">{tx.signing}</p>
</div>
