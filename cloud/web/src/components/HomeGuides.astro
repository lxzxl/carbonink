---
import { getCollection } from 'astro:content';

const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';
const prefix = isZh ? '/zh' : '';
const localePrefix = isZh ? 'zh/' : 'en/';

const guides = (await getCollection('guides', ({ id }) => id.startsWith(localePrefix)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

const tx = isZh
  ? { title: '把碳核算讲清楚', all: '全部指南' }
  : { title: 'Standards & practical playbooks', all: 'All guides' };
---
{guides.length > 0 && (
  <section class="py-16 sm:py-20 px-5 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between gap-4 mb-8">
        <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
          {tx.title}
        </h2>
        <a
          href={`${prefix}/guides/`}
          class="text-sm font-semibold text-primary hover:text-chamber underline whitespace-nowrap transition-colors"
        >
          {tx.all} →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {guides.map((g) => (
          <a
            href={`${prefix}/guides/${g.id.slice(3)}/`}
            class="group flex flex-col justify-between bg-card border border-border border-t-2 border-t-border-strong p-5 hover:border-primary transition-colors"
          >
            <div>
              <h3 class="font-display font-bold text-[15px] leading-snug text-foreground group-hover:text-primary transition-colors mb-2">
                {g.data.title}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{g.data.description}</p>
            </div>
            <div class="font-mono-num text-[11px] text-muted-foreground mt-4 pt-3 border-t border-border">
              {fmtDate(g.data.pubDate)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
