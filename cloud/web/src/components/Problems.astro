---
const { lang } = Astro.props as { lang: 'zh-CN' | 'en' };
const isZh = lang === 'zh-CN';

const tx = isZh
  ? {
      title: '三道合规压力，一个离线工作台',
      sub: '把原始凭证、排放因子快照与上下游披露装进同一个本地工作台，不再东拼西凑表格。',
      items: [
        {
          code: 'EU CSRD',
          head: 'CSRD 供应链压力',
          body: '欧洲客户索要范围三实测数据；拿不出可逐笔溯源的凭证链与口径，就可能丢单。',
        },
        {
          code: 'EU CBAM',
          head: 'CBAM 碳边境税',
          body: '出口欧盟需申报产品内嵌排放量，需要将能源账单、燃料与物料投入冻结在同一套清单。',
        },
        {
          code: 'A 股供应链',
          head: 'A 股供应商调查',
          body: '国内上市公司向全供应链高频收集 GHG 数据；导出 xlsx 表格让供应商零账户直接填报。',
        },
      ],
    }
  : {
      title: 'Built for concrete reporting mandates',
      sub: 'Replace scattered spreadsheets with one local ledger backed by source bills and locked factors.',
      items: [
        {
          code: 'EU CSRD',
          head: 'Supply-chain Scope 3 audits',
          body: 'European buyers demand auditable Scope 3 actuals with per-row source lineage — not rough spend multipliers.',
        },
        {
          code: 'EU CBAM',
          head: 'Embedded product emissions',
          body: 'Consolidate facility power, fuels, and upstream material disclosures under locked emission factor snapshots.',
        },
        {
          code: 'CDP & ESG',
          head: 'Customer disclosure filings',
          body: 'Answer recurring buyer and rating-agency questionnaires directly from inventory with inspectable traces.',
        },
      ],
    };
---
<section class="py-16 sm:py-20 px-5 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        {tx.title}
      </h2>
      <p class="text-sm text-muted-foreground max-w-md">{tx.sub}</p>
    </div>

    <div class="grid md:grid-cols-3 border border-border bg-card">
      {tx.items.map((item) => (
        <div class="p-6 border-t-2 border-t-border-strong border-b md:border-b-0 md:border-r border-border last:border-b-0 md:last:border-r-0 flex flex-col justify-between">
          <div>
            <h3 class="font-display font-bold text-base tracking-tight text-foreground mb-2">
              {item.head}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{item.body}</p>
          </div>
          <div class="font-mono-num text-xs font-medium text-ochre mt-5 pt-3 border-t border-border">
            {item.code}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
