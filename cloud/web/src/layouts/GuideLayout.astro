---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';

const { entry, lang } = Astro.props as {
  entry: CollectionEntry<'guides'>;
  lang: 'zh-CN' | 'en';
};
const isZh = lang === 'zh-CN';
const prefix = isZh ? '/zh' : '';
const localePrefix = isZh ? 'zh/' : 'en/';
const slug = entry.id.replace(/^(en|zh)\//, '');

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const tx = isZh
  ? {
      home: '首页',
      guides: '指南',
      toc: '本文目录',
      related: '相关指南',
      published: '发布于',
      updated: '更新于',
      ctaTitle: '把这套流程交给碳墨',
      ctaBody:
        '免费开源的桌面碳核算软件：AI 解析票据单据、匹配排放因子、一键导出 ISO 14064-1 盘查报告与 TCFD 披露。完全离线运行，数据不出内网。',
      ctaDownload: '免费下载',
      ctaSource: 'GitHub 源码',
      siteTitle: '碳墨指南',
    }
  : {
      home: 'Home',
      guides: 'Guides',
      toc: 'On this page',
      related: 'Related guides',
      published: 'Published',
      updated: 'Updated',
      ctaTitle: 'Put this workflow into practice',
      ctaBody:
        'CarbonInk is lightweight, free, open-source carbon accounting for the desktop: AI extracts bills, locks emission factors, and exports ISO 14064-1 & TCFD reports locally.',
      ctaDownload: 'Download free',
      ctaSource: 'View source',
      siteTitle: 'CarbonInk Guides',
    };

const siblings = await getCollection('guides', ({ id }) => id.startsWith(localePrefix));
const related = entry.data.related
  .map((s) => siblings.find((e) => e.id === localePrefix + s))
  .filter((e): e is CollectionEntry<'guides'> => Boolean(e));

const pageUrl = new URL(`${prefix}/guides/${slug}/`, 'https://carbonink.xyz').toString();
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: lang,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: 'CarbonInk', url: 'https://carbonink.xyz' },
  publisher: { '@type': 'Organization', name: 'CarbonInk', url: 'https://carbonink.xyz' },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tx.home, item: `https://carbonink.xyz${prefix}/` },
    { '@type': 'ListItem', position: 2, name: tx.guides, item: `https://carbonink.xyz${prefix}/guides/` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
  ],
};

const fmtDate = (d: Date) =>
  isZh
    ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
    : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title={`${entry.data.title} — ${tx.siteTitle}`} description={entry.data.description} lang={lang}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <article class="py-10 sm:py-14 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto bg-card border border-border border-t-2 border-t-border-strong p-6 sm:p-10">
      <nav aria-label="Breadcrumb" class="font-mono-num text-xs text-muted-foreground pb-5 mb-6 border-b border-border">
        <a href={`${prefix}/`} class="hover:text-foreground transition-colors">{tx.home}</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <a href={`${prefix}/guides/`} class="hover:text-foreground transition-colors">{tx.guides}</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <span class="text-foreground">{entry.data.title}</span>
      </nav>

      <h1 class="font-display text-3xl sm:text-[2.4rem] font-extrabold tracking-tight leading-[1.15] text-foreground mb-4">
        {entry.data.title}
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mb-4">{entry.data.description}</p>
      <p class="font-mono-num text-xs text-muted-foreground pb-7 mb-8 border-b border-border">
        {tx.published} {fmtDate(entry.data.pubDate)}
        {entry.data.updatedDate && ` · ${tx.updated} ${fmtDate(entry.data.updatedDate)}`}
      </p>

      {toc.length > 2 && (
        <nav aria-label={tx.toc} class="border border-border rounded-[2px] p-5 mb-9 bg-surface">
          <p class="font-mono-num text-xs font-semibold text-primary mb-3">{tx.toc}</p>
          <ol class="space-y-1.5">
            {toc.map((h, i) => (
              <li class="text-sm">
                <a href={`#${h.slug}`} class="text-foreground hover:text-primary transition-colors">
                  <span class="font-mono-num text-xs text-muted-foreground mr-2">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="guide-prose">
        <Content />
      </div>

      {related.length > 0 && (
        <section class="mt-12 pt-8 border-t-2 border-border-strong">
          <h2 class="font-display text-lg font-bold tracking-tight mb-5">{tx.related}</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {related.map((r) => (
              <a
                href={`${prefix}/guides/${r.id.replace(/^(en|zh)\//, '')}/`}
                class="block border border-border bg-surface rounded-[2px] p-4 hover:border-primary transition-colors"
              >
                <p class="font-display font-bold text-[15px] text-foreground mb-1.5">{r.data.title}</p>
                <p class="text-sm text-muted-foreground">{r.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <aside class="chamber-surface mt-10 border-2 border-border-strong bg-chamber text-chamber-foreground rounded-none p-6 sm:p-8">
        <h2 class="font-display text-lg font-bold text-white mb-2">{tx.ctaTitle}</h2>
        <p class="text-sm text-chamber-muted leading-relaxed mb-5 max-w-xl">{tx.ctaBody}</p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`${prefix}/download/`}
            class="inline-flex items-center bg-card text-chamber px-4 py-2 rounded-[2px] font-bold text-sm hover:bg-white transition-colors"
          >
            {tx.ctaDownload}
          </a>
          <a
            href="https://github.com/lxzxl/carbonink"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center border border-chamber-border bg-white/5 text-chamber-foreground px-4 py-2 rounded-[2px] font-semibold text-sm hover:bg-white/10 transition-colors"
          >
            {tx.ctaSource} →
          </a>
        </div>
      </aside>
    </div>
  </article>
</Base>
