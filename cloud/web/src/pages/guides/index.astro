---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guides = (await getCollection('guides', ({ id }) => id.startsWith('en/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Base
  title="Guides — carbon accounting, ISO 14064-1 & GHG inventories | CarbonInk"
  description="Practical, standards-accurate guides to carbon accounting: building an ISO 14064-1 GHG inventory, ISO 14064-1 vs the GHG Protocol, inventory vs verification, and more."
  lang="en"
>
  <section class="chamber-surface bg-chamber text-chamber-foreground py-12 sm:py-14 px-5 sm:px-6 border-b-2 border-border-strong">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        Carbon accounting, explained properly
      </h1>
      <p class="text-sm sm:text-base text-chamber-muted leading-relaxed max-w-2xl">
        Vendor-neutral, standards-accurate guides to greenhouse-gas inventories — written for consultants and sustainability teams whose numbers have to get past an auditor.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16 px-5 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <ul class="divide-y divide-border border border-border border-t-2 border-t-border-strong bg-card">
        {guides.map((g) => (
          <li>
            <a
              href={`/guides/${g.id.slice(3)}/`}
              class="group block px-5 sm:px-6 py-5 hover:bg-surface transition-colors"
            >
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <p class="font-display font-bold text-base text-foreground group-hover:text-primary transition-colors">
                  {g.data.title}
                </p>
                <span class="font-mono-num text-[11px] text-muted-foreground shrink-0">
                  {fmtDate(g.data.pubDate)}
                </span>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{g.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
