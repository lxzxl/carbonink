---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const guides = (await getCollection('guides', ({ id }) => id.startsWith('zh/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Base
  title="指南 — 碳核算 / 碳盘查 / ISO 14064-1 实操 | 碳墨"
  description="面向实操的碳核算指南：ISO 14064-1 温室气体清单编制七步、ISO 14064-1 与 GHG Protocol 的区别、碳盘查和碳核查的区别等，持续更新。"
  lang="zh-CN"
>
  <section class="chamber-surface bg-chamber text-chamber-foreground py-12 sm:py-14 px-5 sm:px-6 border-b-2 border-border-strong">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        把碳核算讲清楚
      </h1>
      <p class="text-sm sm:text-base text-chamber-muted leading-relaxed max-w-2xl">
        中立、贴标准的碳盘查实操指南 —— 写给要把数字送过审核员那一关的顾问和企业可持续团队。
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16 px-5 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <ul class="divide-y divide-border border border-border border-t-2 border-t-border-strong bg-card">
        {guides.map((g) => (
          <li>
            <a
              href={`/zh/guides/${g.id.slice(3)}/`}
              class="group block px-5 sm:px-6 py-5 hover:bg-surface transition-colors"
            >
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <h2 class="font-display font-bold text-base text-foreground group-hover:text-primary transition-colors">
                  {g.data.title}
                </h2>
                <span class="font-mono-num text-[11px] text-muted-foreground shrink-0">
                  {fmtDate(g.data.pubDate)}
                </span>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">{g.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
