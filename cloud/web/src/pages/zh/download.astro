---
export const prerender = true;

import DownloadButtons from '../../components/DownloadButtons.astro';
import Base from '../../layouts/Base.astro';
import { APP_VERSION } from '../../lib/app-version';

const version = `v${APP_VERSION}`;
---
<Base
  title="下载碳墨 — macOS / Windows 免费碳核算软件"
  description="免费下载碳墨桌面端（macOS / Windows）。开源碳核算 / 碳盘查软件，完全离线运行，无需注册账号。"
  lang="zh-CN"
>
  <section class="chamber-surface bg-chamber text-chamber-foreground pt-12 pb-20 px-5 sm:px-6 border-b-2 border-border-strong">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        下载碳墨
      </h1>
      <p class="text-sm sm:text-base text-chamber-muted leading-relaxed">
        轻量原生桌面端，内置 Sparkle（macOS）与 WinSparkle（Windows）自动更新。免登录、免激活，下载即用。
      </p>
      <p class="font-mono-num text-xs text-emerald-bright mt-3">
        {version} · MIT · macOS 13+ &amp; Windows 10/11
      </p>
    </div>
  </section>

  <section class="px-5 sm:px-6 -mt-10 pb-20">
    <div class="max-w-2xl mx-auto bg-card border-2 border-border-strong rounded-none divide-y divide-border shadow-[0_14px_36px_rgba(17,22,20,0.07)]">
      <DownloadButtons lang="zh-CN" />

      <div class="px-6 sm:px-8 py-5 sm:py-6 text-left">
        <h2 class="font-display font-bold text-sm text-foreground mb-2">从碳墨 1.x 升级到 2.0？</h2>
        <ul class="text-xs text-muted-foreground space-y-1.5 leading-relaxed list-disc pl-4">
          <li>1.x（Electron）无法直接在线升级至 2.0，请从上方下载并安装一次 2.0 安装包。</li>
          <li>首次启动 2.0 时会自动以只读方式复制原有 1.x 账套、SQLite 数据库、上传文件与备份（不修改原目录）。</li>
          <li>AI 服务商配置会自动保留，只需在 <strong>设置 → AI 服务</strong> 中重新输入一次 API 密钥即可。</li>
        </ul>
      </div>

      <p class="px-6 sm:px-8 py-4 bg-surface text-xs text-muted-foreground flex flex-wrap items-center justify-between gap-2">
        <span class="font-mono-num">含安装包 SHA-256 校验与发行说明</span>
        <a
          href="https://github.com/lxzxl/carbonink/releases/latest"
          target="_blank"
          rel="noopener"
          class="font-semibold text-primary hover:text-chamber underline transition-colors"
        >
          在 GitHub 查看版本更新日志 →
        </a>
      </p>
    </div>
  </section>
</Base>
