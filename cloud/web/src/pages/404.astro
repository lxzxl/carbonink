---
import LogoMark from '../components/LogoMark.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · Page not found · CarbonInk</title>
    <meta name="theme-color" content="#133325" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-background text-foreground font-[family-name:var(--font-body)] min-h-screen flex items-center justify-center px-5 py-16">
    <main class="w-full max-w-lg bg-card border-2 border-border-strong rounded-none p-8 text-left">
      <div class="flex items-center justify-between gap-4 pb-5 mb-6 border-b border-border">
        <a href="/" class="inline-flex items-center gap-2.5">
          <LogoMark size={30} />
          <span class="font-display font-bold text-base tracking-tight">CarbonInk</span>
        </a>
        <span class="font-mono-num text-xs font-semibold text-ochre border border-border px-2 py-0.5 rounded-[2px]">
          HTTP 404
        </span>
      </div>

      <h1 class="font-display text-2xl font-extrabold tracking-tight text-foreground">
        Page not found
      </h1>
      <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
        This URL doesn't exist on carbonink.xyz. Continue from one of the indexed sections below —
        中文用户请访问 <a href="/zh/" class="font-semibold text-primary underline hover:text-chamber">中文首页</a>。
      </p>

      <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 border-t border-border pt-5" aria-label="Site links">
        <a href="/" class="text-sm font-semibold text-primary hover:text-chamber hover:underline">Home</a>
        <a href="/download/" class="text-sm font-semibold text-primary hover:text-chamber hover:underline">Download</a>
        <a href="/guides/" class="text-sm font-semibold text-primary hover:text-chamber hover:underline">Guides</a>
        <a href="/privacy/" class="text-sm font-semibold text-primary hover:text-chamber hover:underline">Privacy</a>
      </nav>

      <p class="mt-6 pt-4 border-t border-border font-mono-num text-xs text-muted-foreground">
        Machine-readable:
        <a href="/llms.txt" class="underline hover:text-foreground">/llms.txt</a>
        ·
        <a href="/sitemap-index.xml" class="underline hover:text-foreground">/sitemap-index.xml</a>
      </p>
    </main>
  </body>
</html>
